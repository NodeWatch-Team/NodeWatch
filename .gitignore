# Datasets pesados (PaySim e variantes)
# dados/ é para os arquivos de cada máquina (HI-Small, PaySim...); só os exemplos inventados são versionados.
dados/*
!dados/exemplos/

# Logs e artefatos locais
*.log
logs/
output/
*.tmp

# Módulo de ML: artefatos gerados e caminhos locais.
# artefatos_ml/ é a pasta de TRABALHO de cada máquina (análises, datasets enviados, caches, modelo instalado).
# O modelo DISTRIBUÍDO fica em modelos/ (versionado, com MANIFESTO_MODELO.json): não o ignore.
artefatos_ml/
ml_config.local.toml
# Ambiente de teste local (scripts/ambiente_teste.py): pasta isolada do painel, com modelo e datasets sintéticos.
artefatos_teste/

# Configurações locais do Claude Code (caminhos de cada máquina)
.claude/launch.json

# Bancos e logs de execução gerados fora de artefatos_ml/ (por exemplo, ao rodar o painel com outra raiz)
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.jsonl

# Caches de ferramentas de análise de código
.ruff_cache/
.mypy_cache/

# Arquivos do Windows, do OneDrive e travas do Office
desktop.ini
~$*
